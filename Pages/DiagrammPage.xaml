<Page x:Class="UP01.Pages.DiagrammPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      Title="Диаграммы и Экспорт">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="5">
            <TextBlock Text="Пользователь:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="CmbUser" Width="200" SelectionChanged="UpdateChart"/>
            <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="15,5,5,5"/>
            <ComboBox x:Name="CmbType" Width="150" SelectionChanged="UpdateChart"/>
            <Button Content="Экспорт в Word" Click="BtnWord_Click" Background="#2196F3" Margin="5"/>
            <Button Content="Экспорт в Excel" Click="BtnExcel_Click" Background="#4CAF50" Margin="5"/>
        </WrapPanel>

        <wf:WindowsFormsHost x:Name="WfhChart" Grid.Row="1" Margin="5"/>
    </Grid>
</Page>