<Page x:Class="UP01.Pages.AddCategoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Редактирование категории">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel>
            <TextBlock Text="Название категории"/>
            <TextBox x:Name="TbName" Text="{Binding Name}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Сохранить" Click="BtnSave_Click"/>
                <Button Content="Отмена" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>