<Page x:Class="UP01.Pages.AddCarPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Редактирование автомобиля">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel>
            <TextBlock Text="Клиент"/>
            <ComboBox x:Name="CbClient" DisplayMemberPath="FIO" SelectedValuePath="ID" SelectedValue="{Binding ClientID}"/>
            <TextBlock Text="Марка"/>
            <TextBox x:Name="TbBrand" Text="{Binding Brand}"/>
            <TextBlock Text="Модель"/>
            <TextBox x:Name="TbModel" Text="{Binding Model}"/>
            <TextBlock Text="Гос. номер"/>
            <TextBox x:Name="TbPlate" Text="{Binding LicensePlate}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Сохранить" Click="BtnSave_Click"/>
                <Button Content="Отмена" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>