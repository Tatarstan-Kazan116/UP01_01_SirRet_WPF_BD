<Window x:Class="UP01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автосервис UP01" Height="700" Width="1000" 
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Левая часть: Кнопка Назад -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="BtnBack" Content="Назад" Click="BtnBack_Click" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Центр: Динамический заголовок -->
        <TextBlock x:Name="TxtPageTitle" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>

        <!-- Правая часть: Кнопка смены темы -->
        <Button x:Name="BtnTheme" Content="Сменить тему" Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,20,0" Click="BtnTheme_Click" Width="140"/>

        <!-- Основная область для страниц -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <!-- Нижняя часть: Дата и время -->
        <TextBlock x:Name="DateTimeNow" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/>
    </Grid>
</Window>