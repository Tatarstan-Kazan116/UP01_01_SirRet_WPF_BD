 <Page x:Class="UP01.Pages.AddUserPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Редактирование пользователя">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel>
            <TextBlock Text="ФИО"/>
            <TextBox x:Name="TbFIO" Text="{Binding FIO}"/>
            <TextBlock Text="Логин"/>
            <TextBox x:Name="TbLogin" Text="{Binding Login}"/>
            <TextBlock Text="Пароль (оставьте пустым, если не меняете)"/>
            <PasswordBox x:Name="PbPass"/>
            <TextBlock Text="Роль"/>
            <ComboBox x:Name="CbRole" SelectedValue="{Binding Role}" SelectedValuePath="Content">
                <ComboBoxItem Content="User"/>
                <ComboBoxItem Content="Admin"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Сохранить" Click="BtnSave_Click"/>
                <Button Content="Отмена" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>