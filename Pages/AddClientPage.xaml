<Page x:Class="UP01.Pages.AddClientPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Редактирование клиента">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel>
            <TextBlock Text="ФИО"/>
            <TextBox x:Name="TbFIO" Text="{Binding FIO}"/>
            <TextBlock Text="Телефон"/>
            <TextBox x:Name="TbPhone" Text="{Binding Phone}"/>
            <TextBlock Text="Email"/>
            <TextBox x:Name="TbEmail" Text="{Binding Email}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Сохранить" Click="BtnSave_Click"/>
                <Button Content="Отмена" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>