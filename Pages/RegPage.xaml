<Page x:Class="UP01.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel>
            <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- ФИО -->
            <TextBlock Text="ФИО"/>
            <TextBox x:Name="txtbxFIO" ToolTip="Иванов И.И." Margin="5"/>

            <!-- Логин -->
            <TextBlock Text="Логин"/>
            <TextBox x:Name="txtbxLog" ToolTip="Придумайте логин" Margin="5"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="passBxFrst" ToolTip="Мин 6 символов, англ, цифры" Margin="5"/>

            <!-- Подтверждение пароля -->
            <TextBlock Text="Подтверждение"/>
            <PasswordBox x:Name="passBxScnd" ToolTip="Повторите пароль" Margin="5"/>

            <!-- Роль -->
            <TextBlock Text="Роль"/>
            <ComboBox x:Name="comboBxRole" Margin="5">
                <ComboBoxItem Content="User" IsSelected="True"/>
                <ComboBoxItem Content="Admin"/>
            </ComboBox>

            <Button x:Name="regButton" Content="Зарегистрироваться" Click="regButton_Click" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Page>