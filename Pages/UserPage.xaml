<Page x:Class="UP01.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинет пользователя"
      Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <WrapPanel Grid.Row="0" Margin="5" Orientation="Horizontal">
            <TextBlock Text="Поиск по названию:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TbFilter" Width="200" TextChanged="TbFilter_TextChanged" Margin="5"
                     ToolTip="Введите название категории для поиска"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="15,5,5,5"/>
            <ComboBox x:Name="CbSort" Width="180" SelectionChanged="CbSort_SelectionChanged" Margin="5">
                <ComboBoxItem Content="По возрастанию" IsSelected="True"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>

            <Button Content="Сбросить" Click="BtnClear_Click" Margin="15,0,0,0"
                    ToolTip="Сбросить все фильтры"/>
        </WrapPanel>

        <!-- Таблица категорий -->
        <DataGrid x:Name="DgCategories" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" Margin="5"
                  ToolTip="Список категорий услуг автосервиса">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                <DataGridTextColumn Header="Название категории" Binding="{Binding Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>