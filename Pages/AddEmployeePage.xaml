<Page x:Class="UP01.Pages.AddEmployeePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Редактирование сотрудника">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel>
            <TextBlock Text="ФИО"/>
            <TextBox x:Name="TbFIO" Text="{Binding FIO}"/>
            <TextBlock Text="Должность"/>
            <TextBox x:Name="TbPosition" Text="{Binding Position}"/>
            <TextBlock Text="Зарплата"/>
            <TextBox x:Name="TbSalary" Text="{Binding Salary}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Сохранить" Click="BtnSave_Click"/>
                <Button Content="Отмена" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>