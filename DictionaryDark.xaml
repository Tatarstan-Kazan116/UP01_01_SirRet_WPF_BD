<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Цвета тёмной темы -->
    <SolidColorBrush x:Key="BgBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="FgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#3E3E42"/>

    <!-- Глобальные стили — используем DynamicResource -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        <Setter Property="FontFamily" Value="Open Sans, Segoe UI"/>
    </Style>
    <Style TargetType="Page">
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        <Setter Property="FontFamily" Value="Open Sans, Segoe UI"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Open Sans, Segoe UI"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Open Sans, Segoe UI"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Open Sans, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="Open Sans, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Open Sans, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Open Sans, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
    </Style>
    <Style TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    </Style>
</ResourceDictionary>