<Page x:Class="UP01.Pages.CarTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление автомобилями">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="5">
            <TextBlock Text="Поиск по марке:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TbFilter" Width="150" TextChanged="TbFilter_TextChanged" Margin="5"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="15,5,5,5"/>
            <ComboBox x:Name="CbSort" Width="150" SelectionChanged="CbSort_SelectionChanged" Margin="5">
                <ComboBoxItem Content="По марке" IsSelected="True"/>
                <ComboBoxItem Content="По модели"/>
            </ComboBox>

            <Button Content="Добавить" Click="BtnAdd_Click" Background="#2196F3" Margin="15,0,0,0"/>
            <Button Content="Редактировать" Click="BtnEdit_Click" Background="#4CAF50"/>
            <Button Content="Удалить" Click="BtnDelete_Click" Background="#F44336"/>
            <Button Content="Сбросить" Click="BtnClear_Click" Background="#FF9800"/>
        </WrapPanel>

        <DataGrid x:Name="DgCars" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Марка" Binding="{Binding Brand}" Width="100"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="100"/>
                <DataGridTextColumn Header="Гос. номер" Binding="{Binding LicensePlate}" Width="100"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Client.FIO}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>