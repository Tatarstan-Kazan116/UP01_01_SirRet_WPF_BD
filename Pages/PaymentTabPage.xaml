<Page x:Class="UP01.Pages.PaymentTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление заказ-нарядами">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="5">
            <TextBlock Text="Поиск по услуге:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TbFilter" Width="150" TextChanged="TbFilter_TextChanged" Margin="5"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="15,5,5,5"/>
            <ComboBox x:Name="CbSort" Width="150" SelectionChanged="CbSort_SelectionChanged" Margin="5">
                <ComboBoxItem Content="По дате" IsSelected="True"/>
                <ComboBoxItem Content="По сумме"/>
            </ComboBox>

            <Button Content="Добавить" Click="BtnAdd_Click" Background="#2196F3" Margin="15,0,0,0"/>
            <Button Content="Редактировать" Click="BtnEdit_Click" Background="#4CAF50"/>
            <Button Content="Удалить" Click="BtnDelete_Click" Background="#F44336"/>
            <Button Content="Сбросить" Click="BtnClear_Click" Background="#FF9800"/>
        </WrapPanel>

        <DataGrid x:Name="DgPayments" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Num}" Width="70"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice}" Width="100"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="150"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding User.FIO}" Width="150"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee.FIO}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>