<Page x:Class="UP01.Pages.AddPaymentPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Редактирование заказ-наряда">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel>
            <TextBlock Text="Дата"/>
            <DatePicker x:Name="DpDate" SelectedDate="{Binding Date}"/>
            <TextBlock Text="Клиент (User)"/>
            <ComboBox x:Name="CbUser" DisplayMemberPath="FIO" SelectedValuePath="ID" SelectedValue="{Binding UserID}"/>
            <TextBlock Text="Категория"/>
            <ComboBox x:Name="CbCategory" DisplayMemberPath="Name" SelectedValuePath="ID" SelectedValue="{Binding CategoryID}"/>
            <TextBlock Text="Название услуги"/>
            <TextBox x:Name="TbName" Text="{Binding Name}"/>
            <TextBlock Text="Количество"/>
            <TextBox x:Name="TbNum" Text="{Binding Num}"/>
            <TextBlock Text="Цена"/>
            <TextBox x:Name="TbPrice" Text="{Binding Price}"/>
            <TextBlock Text="Сотрудник" Margin="0,10,0,0"/>
            <ComboBox x:Name="CbEmployee" DisplayMemberPath="FIO" SelectedValuePath="ID" SelectedValue="{Binding EmployeeID}" ToolTip="Выберите сотрудника"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Сохранить" Click="BtnSave_Click"/>
                <Button Content="Отмена" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>