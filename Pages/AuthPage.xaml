<Page x:Class="UP01.Pages.AuthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Авторизация">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel x:Name="LoginPanel">
            <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Логин"/>
            <TextBox x:Name="TbLogin" ToolTip="Введите логин"/>
            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="PbPassword" ToolTip="Введите пароль"/>
            <Button Content="Войти" Click="BtnLogin_Click" Margin="0,20,0,10"/>
            <Button Content="Регистрация" Click="BtnReg_Click"/>
            <Button Content="Смена пароля" Click="BtnChangePass_Click"/>
        </StackPanel>
        <StackPanel x:Name="CaptchaPanel" Visibility="Hidden">
            <TextBlock Text="Введите капчу:" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtCaptcha" FontSize="24" FontWeight="Bold" Foreground="Red" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,10"/>
            <TextBox x:Name="TbCaptchaInput" ToolTip="Введите символы с картинки"/>
            <Button Content="Подтвердить" Click="BtnCaptcha_Click" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Page>